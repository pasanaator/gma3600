 static IMG_VOID
 FreePages(IMG_BOOL bToPagePool, struct page **ppsPageList, IMG_HANDLE hBlockPageList, IMG_UINT32 ui32NumPages)
 {
+#if defined(GMA3600_SGX_PREPARE_ONLY)
+    struct gma3600_sgx_pages *allocation = hBlockPageList;
+    PVR_UNREFERENCED_PARAMETER(bToPagePool);
+    if (!allocation || allocation->pages != ppsPageList ||
+        allocation->count != ui32NumPages) {
+        pr_err("gma3600 SGX: invalid page allocation handle\n");
+        return;
+    }
+    if (gma3600_sgx_pages_free(allocation))
+        pr_err("gma3600 SGX: retaining pages after failed WB restoration\n");
+#else
     IMG_INT32 i;
 
     for(i = 0; i < (IMG_INT32)ui32NumPages; i++)
@@ -1035,6 +1071,7 @@
 #endif
 
     (IMG_VOID) OSFreeMem(0, sizeof(*ppsPageList) * ui32NumPages, ppsPageList, hBlockPageList);
+#endif
 }
 
 
