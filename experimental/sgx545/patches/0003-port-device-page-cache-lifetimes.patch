@@ -957,6 +958,29 @@
 static IMG_BOOL
 AllocPages(IMG_UINT32 ui32AreaFlags, struct page ***pppsPageList, IMG_HANDLE *phBlockPageList, IMG_UINT32 ui32NumPages, IMG_BOOL *pbFromPagePool)
 {
+#if defined(GMA3600_SGX_PREPARE_ONLY)
+    struct gma3600_sgx_pages *allocation = NULL;
+    enum gma3600_sgx_cache cache;
+    int ret;
+    *pppsPageList = NULL;
+    *phBlockPageList = NULL;
+    *pbFromPagePool = IMG_FALSE;
+    switch (ui32AreaFlags & PVRSRV_HAP_CACHETYPE_MASK) {
+    case PVRSRV_HAP_CACHED: cache = GMA_SGX_WB; break;
+    case PVRSRV_HAP_WRITECOMBINE: cache = GMA_SGX_WC; break;
+    case PVRSRV_HAP_UNCACHED: cache = GMA_SGX_UC; break;
+    default: return IMG_FALSE;
+    }
+    ret = gma3600_sgx_pages_alloc(ui32NumPages, cache, &allocation);
+    if (ret) {
+        if (allocation && gma3600_sgx_pages_free(allocation))
+            pr_err("gma3600 SGX: retaining pages after failed WB restoration\n");
+        return IMG_FALSE;
+    }
+    *pppsPageList = allocation->pages;
+    *phBlockPageList = allocation;
+    return IMG_TRUE;
+#else
     struct page **ppsPageList;
     IMG_HANDLE hBlockPageList;
